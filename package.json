{
  "name": "@isoldex/sentinel",
  "version": "4.2.0",
  "description": "AI-powered browser automation with Gemini – fast, cheap Stagehand alternative",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test/index.d.ts",
      "import": "./dist/test/index.js",
      "default": "./dist/test/index.js"
    }
  },
  "bin": {
    "sentinel": "dist/cli/index.js",
    "sentinel-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=/node_modules/ --testMatch=\"**/src/__tests__/e2e/**/*.test.ts\" --runInBand",
    "mcp:stdio": "node dist/mcp/index.js",
    "mcp:http": "cross-env SENTINEL_MCP_HTTP=1 node dist/mcp/index.js",
    "mcp:dev": "cross-env SENTINEL_MCP_HTTP=1 node --watch dist/mcp/index.js"
  },
  "keywords": [
    "browser-automation",
    "stagehand-alternative",
    "stagehand",
    "browseruse-alternative",
    "browseruse",
    "ai-browser-automation",
    "playwright-ai",
    "playwright",
    "gemini",
    "openai",
    "anthropic",
    "llm",
    "ai",
    "web-scraping",
    "web-testing",
    "testautomation",
    "selenium-alternative",
    "mcp",
    "self-healing"
  ],
  "author": "Huseyin Aras <hueseyin.aras1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArasHuseyin/sentinel.ai.git"
  },
  "bugs": {
    "url": "https://github.com/ArasHuseyin/sentinel.ai/issues"
  },
  "homepage": "https://isoldex.ai",
  "peerDependencies": {
    "@playwright/test": ">=1.40.0",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.59.1",
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jest": "^30.3.0",
    "openai": "^7.3.0",
    "playwright": "^1.59.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
