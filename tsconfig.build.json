// Emit configuration for the published package.
//
// `tsconfig.json` type-checks everything (src, tests, dev scripts); this file is
// the only one that writes to dist/. Tests and ad-hoc scripts are excluded so
// they never reach the tarball, which keeps `files: ["dist"]` in package.json
// safe to use as a whole-directory allowlist — no per-file list to forget.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    // No maps in the tarball. The base config emits both for local debugging,
    // but `files: ["dist"]` ships no `src/`, so every published .js.map and
    // .d.ts.map pointed at sources that were not there — 108 files and 390 kB
    // (37% of the package) of references that no debugger could resolve.
    // The alternatives were shipping src/ or inlining it via `inlineSources`,
    // both of which make the package bigger to fix a problem nobody hit.
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["src/__tests__/**", "node_modules", "dist", "examples", "scripts"]
}
